        "solenoid_valve_1": {
          "name": "电磁阀1",
          "plc_port": "Y0",
          "reg_addr": "0x0500",
          "commands": {
            "open":  ["0x01", "0x05", "0x05", "0x00", "0xFF", "0x00", "0x8C", "0xF6"],
            "close": ["0x01", "0x05", "0x05", "0x00", "0x00", "0x00", "0xCD", "0x06"],
            "query": ["0x01", "0x01", "0x05", "0x00", "0x00", "0x01", "0xFD", "0x06"]
          }
        },
        "solenoid_valve_2": {
          "name": "电磁阀2",
          "plc_port": "Y1",
          "reg_addr": "0x0501",
          "commands": {
            "open":  ["0x01", "0x05", "0x05", "0x01", "0xFF", "0x00", "0xDD", "0x36"],
            "close": ["0x01", "0x05", "0x05", "0x01", "0x00", "0x00", "0x9C", "0xC6"],
            "query": ["0x01", "0x01", "0x05", "0x01", "0x00", "0x01", "0xAC", "0xC6"]
          }
        }
      }
    },
    "plc_2": {
      "slave_addr": "0x02",
      "bind_serial_port": "/dev/ttyUSB10",
      "description": "2号PLC，从机地址0x02，接烟感探测器",
      "components": {
        "water_level_sensor_1": {
          "name": "水位传感器",
          "plc_port": "X0",
          "reg_addr": "0x0400",
          "commands": {
            "query": ["0x02", "0x01", "0x04", "0x00", "0x00", "0x01", "0xFC", "0xC9"]
          }
        },
        "smoke_alarm_1": {
          "name": "烟感报警器",
          "plc_port": "X1",
          "reg_addr": "0x0401",
          "commands": {
            "query": ["0x02", "0x01", "0x04", "0x01", "0x00", "0x01", "0xAD", "0x09"]
          }
        }
      }
    },
    "plc_3": {
      "slave_addr": "0x03",
      "bind_serial_port": "/dev/ttyS3",
      "description": "3号PLC，绑定红外传感器",
      "components": {
        "infrared_sensor_1": {
          "name": "红外传感器",
          "plc_port": "X0",
          "reg_addr": "0x0400",
          "commands": {
            "query": ["0x03", "0x01", "0x04", "0x00", "0x00", "0x01", "0xFD", "0x18"]
          }
        }
      }
    }
  },
  "linux_direct_devices": {
    "gpio_devices": [
      {
        "id": "door_lock_1",
        "name": "门锁1",
        "gpio_group": 3,          // 新增：GPIO组号（用于计算物理编号）
        "gpio_pin_num": 4,        // 新增：GPIO引脚号（用于计算物理编号）
        "pin": 100,               // 兼容原有：计算结果（3×32+4=100）
        "chip_name": "gpiochip0",
        "direction": "out",
        "initial_value": 0,
        "active_logic": "high",
        "voltage_domain": "3.3V",
        "description": "DC-A568-V06主板GPIO4，控制门锁继电器，1=导通，0=断开"
      },
      {
        "id": "sensor_nc_1",      // 常闭(NC)传感器ID
        "name": "常闭传感器1",
        "gpio_group": 1,          // GPIO1组
        "gpio_pin_num": 1,        // 组内引脚1
        "pin": 33,                // 计算结果：1×32+1=33
        "chip_name": "gpiochip0",
        "direction": "in",        // 传感器为输入模式
        "sensor_type": "NC",      // 传感器类型：常闭
        "level_rule": "high=导通,low=不导通", // 电平规则
        "voltage_domain": "3.3V",
        "description": "GPIO1_A1_u（物理编号33），常闭传感器，高电平=导通，低电平=不导通"
      },
      {
        "id": "sensor_no_1",      // 常开(NO)传感器ID
        "name": "常开传感器1",
        "gpio_group": 1,          // GPIO1组
        "gpio_pin_num": 0,        // 组内引脚0
        "pin": 32,                // 计算结果：1×32+0=32
        "chip_name": "gpiochip0",
        "direction": "in",        // 传感器为输入模式
        "sensor_type": "NO",      // 传感器类型：常开
        "level_rule": "high=不导通,low=导通", // 电平规则
        "voltage_domain": "3.3V",
        "description": "GPIO1_A0_u（物理编号32），常开传感器，高电平=不导通，低电平=导通"
      }
    ],
    "serial_direct_devices": [
      {
        "id": "humiture_sensor_1",
        "name": "温湿度传感器",
        "bind_serial_port": "/dev/ttyUSB11",   //这个端口号要根据实际的需求改
        "slave_addr": "0x01",
        "reg_addr": "0x0000",
        "read_regs": 2,
        "commands": {
          "query": ["0x01", "0x03", "0x00", "0x00", "0x00", "0x02", "0xC4", "0x0B"]
        },
        "description": "USB转485直连MODBUS RTU温湿度传感器"
      }
    ]
  },
  "polling_interval_ms": 1000,
  "version": "V1.4-PLC2-X2-Fix",
  "update_time": "2026-03-07"
}
