{
  "system_config": {
    "serial_ports": {
      "/dev/ttyS4": {
        "plc_id": 1,
        "baud_rate": 9600,
        "data_bits": 8,
        "stop_bits": 1,
        "parity": "none",
        "read_timeout_ms": 1000,
        "max_retries": 3,
        "description": "485串口ttyS4，绑定1号PLC"
      },
      "/dev/ttyS3": {
        "plc_id": 3,
        "baud_rate": 9600,
        "data_bits": 8,
        "stop_bits": 1,
        "parity": "none",
        "read_timeout_ms": 1000,
        "max_retries": 3,
        "description": "232串口ttyS3"
      },
      "/dev/ttyUSB10": {
        "plc_id": 2,
        "baud_rate": 9600,
        "data_bits": 8,
        "stop_bits": 1,
        "parity": "none",
        "read_timeout_ms": 1000,
        "max_retries": 3,
        "description": "USB转串口，连接2号PLC"
      }
    },
    "gpio_chip": {
      "chip_name": "gpiochip0",
      "description": "Linux主机GPIO控制器芯片"
    }
  },
  "plc_devices": {
    "plc_1": {
      "slave_addr": "0x01",
      "bind_serial_port": "/dev/ttyS4",
      "description": "1号PLC，从机地址0x01",
