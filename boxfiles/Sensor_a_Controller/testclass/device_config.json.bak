{
  "system_config": {
    "serial_port_manage": {
      "description": "485串口文件描述符与PLC绑定，一个串口对应一个PLC，防止串口多操作冲突",
      "/dev/ttys4": {
        "plc_id": 1,
        "is_used": false,
        "baud_rate": 9600,
        "data_bits": 8,
        "stop_bits": 1,
        "parity": "none",
        "description": "485串口ttys4，绑定1号PLC，通信参数匹配PLC的D8120=0x81"
      },
      "/dev/ttys1": {
        "plc_id": 2,
        "is_used": false,
        "baud_rate": 9600,
        "data_bits": 8,
        "stop_bits": 1,
        "parity": "none",
        "description": "232串口ttys1，绑定2号PLC，通信参数匹配PLC的D8120=0x81"
      },
      "/dev/ttys3": {
        "plc_id": 3,
        "is_used": false,
        "baud_rate": 9600,
        "data_bits": 8,
        "stop_bits": 1,
        "parity": "none",
        "description": "232串口ttys3，绑定3号PLC，通信参数匹配PLC的D8120=0x81"
      }
    },
    "gpio_chip": {
      "chip_name": "gpiochip0",
      "description": "Linux主机GPIO控制器芯片，RK3568默认gpiochip0，需与硬件匹配"
    }
  },
  "plc_device_list": {
    "description": "PLC设备列表，从机地址与plc_id一一对应，梯形图中配置D8121=从机地址",
    "plc_1": {
      "plc_id": 1,
      "slave_address_hex": "0x01",
      "bind_serial_port": "/dev/ttys4",
      "description": "1号PLC，从机地址0x01，绑定485串口ttys4",
      "external_components": {
        "solenoid_valve_1": {
          "component_name": "电磁阀",
          "bind_plc_port": "Y0",
          "port_address_hex": "0x0005",
          "vendor_desc": "PLC厂商规定Y0操作地址为0x0005（0x05 0x00）",
          "operate_cmd": {
            "open": {
              "desc": "电磁阀打开-写单个线圈(MODBUS功能码0x05)",
              "send_buf_hex": ["0x01", "0x05", "0x05", "0x00", "0xFF", "0x00", "0x8C", "0xF6"]
            },
            "close": {
              "desc": "电磁阀关闭-写单个线圈(MODBUS功能码0x05)",
              "send_buf_hex": ["0x01", "0x05", "0x05", "0x00", "0x00", "0x00", "0xCD", "0x06"]
            },
            "query": {
              "desc": "电磁阀状态查询-读线圈寄存器(MODBUS功能码0x01)",
              "send_buf_hex": ["0x01", "0x01", "0x05", "0x00", "0x00", "0x01", "0xFD", "0x06"]
            }
          }
        }
      }
    },
    "plc_2": {
      "plc_id": 2,
      "slave_address_hex": "0x02",
      "bind_serial_port": "/dev/ttys1",
      "description": "2号PLC，从机地址0x02，绑定232串口ttys1",
      "external_components": {
        "water_level_sensor_1": {
          "component_name": "水位传感器",
          "bind_plc_port": "X0",
          "port_address_hex": "0x0004",
          "vendor_desc": "PLC厂商规定X0操作地址为0x0004（0x04 0x00）",
          "operate_cmd": {
            "query": {
              "desc": "水位传感器状态查询-读线圈寄存器(MODBUS功能码0x01)",
              "send_buf_hex": ["0x02", "0x01", "0x04", "0x00", "0x00", "0x01", "0xFC", "0xC9"]
            }
          }
        },
        "smoke_alarm_1": {
          "component_name": "烟感报警器",
          "bind_plc_port": "X1",
          "port_address_hex": "0x0104",
          "vendor_desc": "PLC厂商规定X1操作地址为0x0104（0x04 0x01）",
          "operate_cmd": {
            "query": {
              "desc": "烟感报警器状态查询-读线圈寄存器(MODBUS功能码0x01)",
              "send_buf_hex": ["0x02", "0x01", "0x04", "0x01", "0x00", "0x01", "0xAD", "0x3A"]
            }
          }
        }
      }
    },
    "plc_3": {
      "plc_id": 3,
      "slave_address_hex": "0x03",
      "bind_serial_port": "/dev/ttys3",
      "description": "3号PLC，从机地址0x03，绑定485串口ttys3",
      "external_components": {
        "infrared_sensor_1": {
          "component_name": "红外传感器",
          "bind_plc_port": "X0",
          "port_address_hex": "0x0004",
          "vendor_desc": "PLC厂商规定X0操作地址为0x0004（0x04 0x00）",
          "operate_cmd": {
            "query": {
              "desc": "红外传感器状态查询-读线圈寄存器(MODBUS功能码0x01)",
              "send_buf_hex": ["0x03", "0x01", "0x04", "0x00", "0x00", "0x01", "0xFD", "0x18"]
            }
          }
        }
      }
    }
  },
  "linux_direct_device": {
    "description": "Linux主机GPIO直连设备，一个GPIO_PIN绑定一个设备，调用内置GPIO函数控制",
    "gpio_device": [
      {
        "device_id": "door_lock_1",
        "device_name": "门锁1",
        "gpio_pin": 100,
        "gpio_physical_desc": "DC-A568-V06主板GPIO4（GPIO3_A4_d），组3×32+引脚4=100",
        "voltage_domain": "3.3V",
        "control_desc": "GPIO_PIN=100传入内置GPIO函数，实现门锁开关控制，外接12V变压器",
        "note": "默认低电平断开，高电平导通，需串1KΩ限流电阻"
      },
      {
        "device_id": "door_lock_2",
        "device_name": "门锁2",
        "gpio_pin": 101,
        "gpio_physical_desc": "DC-A568-V06主板GPIO2（GPIO3_A5_d），组3×32+引脚5=101",
        "voltage_domain": "3.3V",
        "control_desc": "GPIO_PIN=101传入内置GPIO函数，实现门锁开关控制，外接12V变压器",
        "note": "默认低电平断开，高电平导通，需串1KΩ限流电阻"
      }
    ]
  },
  "version": "V1.0",
  "update_time": "2026-03-06",
  "maintain_note": "1、Modbus报文16进制数组按发送顺序排列；2、串口is_used为程序运行时动态修改，初始为false；3、PLC外接元器件port_address_hex为厂商规定的操作地址，与报文中地址段一致；4、新增设备需保证device_id/plc_id/串口绑定唯一"
}